{
    "compilerOptions": {
        "target": "es2022",
        "lib": ["es2023"],
        "skipLibCheck": true,
        "strict": true,
        "noFallthroughCasesInSwitch": true,
        "module": "esnext",
        "moduleResolution": "bundler",
        "resolveJsonModule": true,
        "isolatedModules": true,
        "noEmit": true,
        "types": ["node"]
    },
    "include": ["src/main", "src/preload"]
}
