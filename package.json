{
    "name": "mycelo",
    "productName": "myCelo",
    "version": "2.9.0",
    "description": "COH2/COH3 ranking display",
    "license": "GPL-3.0-or-later",
    "author": "Sergei Polishsuk",
    "engines": {
        "node": ">=22.22.1"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/sepi4/myCeloJs/"
    },
    "publish": {
        "provider": "github",
        "releaseType": "release"
    },
    "main": "out/main/index.js",
    "scripts": {
        "dev": "electron-vite dev",
        "build": "electron-vite build",
        "preview": "electron-vite preview",
        "test": "jest",
        "coverage": "jest --coverage && xdg-open coverage/index.html",
        "dist": "npm run typecheck && npm test && npm run build && electron-builder && npm run e2e:dist",
        "dist-win": "npm run typecheck && npm test && npm run build && electron-builder --win",
        "release": "npm run typecheck && npm test && npm run build && electron-builder --linux --win --publish always",
        "e2e": "npm run build && npx playwright test",
        "e2e:debug": "npm run build && npx playwright test --debug inspector",
        "e2e:dist": "MYCELO_DIST_PATH=dist/linux-unpacked/mycelo npx playwright test",
        "typecheck": "tsc --noEmit",
        "format": "prettier --write .",
        "prepare": "husky"
    },
    "dependencies": {
        "@fortawesome/fontawesome-svg-core": "^7.3.1",
        "@fortawesome/free-solid-svg-icons": "^7.3.1",
        "@fortawesome/react-fontawesome": "^3.5.0",
        "dayjs": "^1.11.21",
        "electron-updater": "^6.8.9",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "string-width": "^8.2.2",
        "zustand": "^5.0.14"
    },
    "lint-staged": {
        "*.{ts,tsx}": [
            "prettier --write",
            "eslint --fix --max-warnings 0 --no-warn-ignored"
        ],
        "*.{js,json,css}": "prettier --write"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@playwright/test": "^1.61.1",
        "@types/jest": "^30.0.0",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^5.2.0",
        "electron": "^41.10.2",
        "electron-builder": "^26.15.3",
        "electron-vite": "^5.0.0",
        "eslint": "^9.39.5",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-jest": "^29.15.5",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-simple-import-sort": "^14.0.0",
        "globals": "^17.7.0",
        "husky": "^9.1.7",
        "jest": "^30.4.2",
        "jest-environment-jsdom": "^30.4.1",
        "lint-staged": "^17.1.0",
        "prettier": "^3.9.6",
        "ts-jest": "^29.4.11",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.64.0",
        "typescript-plugin-css-modules": "^5.2.0",
        "vite": "^7.3.6"
    }
}
