{
    "name": "mycelo",
    "productName": "myCelo",
    "version": "2.10.0",
    "description": "COH2/COH3 ranking display",
    "license": "GPL-3.0-or-later",
    "author": "Sergei Polishsuk",
    "engines": {
        "node": ">=24"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/sepi4/myCeloJs/"
    },
    "publish": {
        "provider": "github",
        "releaseType": "release"
    },
    "main": "out/main/index.js",
    "scripts": {
        "dev": "electron-vite dev",
        "build": "electron-vite build",
        "preview": "electron-vite preview",
        "test": "vitest run",
        "coverage": "vitest run --coverage && xdg-open coverage/index.html",
        "dist": "npm run typecheck && npm test && npm run build && electron-builder && npm run e2e:dist",
        "e2e": "npm run build && npx playwright test",
        "e2e:debug": "npm run build && npx playwright test --debug inspector",
        "e2e:dist": "MYCELO_DIST_PATH=dist/linux-unpacked/mycelo npx playwright test",
        "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
        "lint": "oxlint --max-warnings 0",
        "format": "oxfmt",
        "format:check": "oxfmt --check",
        "prepare": "husky",
        "postinstall": "install-electron"
    },
    "dependencies": {
        "dayjs": "^1.11.23",
        "electron-updater": "^6.8.11",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "string-width": "^8.3.0",
        "zustand": "^5.0.16"
    },
    "lint-staged": {
        "*.{ts,tsx}": [
            "oxfmt --no-error-on-unmatched-pattern",
            "oxlint --fix --max-warnings 0 --no-error-on-unmatched-pattern"
        ],
        "*.{js,json,css}": "oxfmt --no-error-on-unmatched-pattern"
    },
    "devDependencies": {
        "@playwright/test": "^1.64.1",
        "@types/node": "^26.6.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "@vitest/coverage-v8": "^5.0.5",
        "electron": "44.9.3",
        "electron-builder": "^26.18.0",
        "electron-vite": "^6.0.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.0",
        "oxfmt": "^0.75.0",
        "oxlint": "^1.90.0",
        "typescript": "^7.0.2",
        "vite": "^8.3.5",
        "vitest": "^5.0.5"
    }
}
